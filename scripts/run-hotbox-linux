#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
	echo "usage: $0 /absolute/path/to/hotbox /absolute/path/to/vault /absolute/workspace" >&2
	exit 64
fi
if [ "$(uname -s)" != "Linux" ]; then
	echo "run-hotbox-linux: Linux is required" >&2
	exit 69
fi
command -v systemd-run >/dev/null 2>&1 || {
	echo "run-hotbox-linux: systemd-run is required; refusing an unsandboxed fallback" >&2
	exit 69
}
command -v systemctl >/dev/null 2>&1 || {
	echo "run-hotbox-linux: systemctl is required; refusing an unsandboxed fallback" >&2
	exit 69
}
systemd_version=$(systemctl --version | awk 'NR == 1 { print $2 }')
case "$systemd_version" in
	''|*[!0-9]*)
		echo "run-hotbox-linux: could not determine the systemd version" >&2
		exit 69
		;;
esac
if [ "$systemd_version" -lt 235 ]; then
	echo "run-hotbox-linux: systemd 235 or newer is required" >&2
	exit 69
fi
if [ "$(stat -fc %T /sys/fs/cgroup 2>/dev/null || true)" != "cgroup2fs" ]; then
	echo "run-hotbox-linux: cgroup v2 is required for network enforcement" >&2
	exit 69
fi
systemctl --user show-environment >/dev/null 2>&1 || {
	echo "run-hotbox-linux: no active systemd user manager" >&2
	exit 69
}
python=$(command -v python3 || true)
[ -n "$python" ] || {
	echo "run-hotbox-linux: python3 is required for the fail-closed network probe" >&2
	exit 69
}

binary=$1
vault=$2
workspace=$3
case "$binary:$vault:$workspace" in
	/*:/*:/*) ;;
	*)
		echo "run-hotbox-linux: all paths must be absolute" >&2
		exit 64
		;;
esac
[ -x "$binary" ] || {
	echo "run-hotbox-linux: Hotbox binary is not executable" >&2
	exit 66
}
[ -d "$workspace" ] || {
	echo "run-hotbox-linux: workspace is not a directory" >&2
	exit 66
}
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] || {
	echo "run-hotbox-linux: XDG_RUNTIME_DIR is required so host clients can reach the Unix socket" >&2
	exit 69
}

vault_dir=$(dirname "$vault")
case "$workspace:$vault_dir:$XDG_RUNTIME_DIR" in
	*[[:space:]]*)
		echo "run-hotbox-linux: paths containing whitespace are not supported by systemd path lists" >&2
		exit 64
		;;
esac

systemd-run --user --quiet --wait --collect --pipe \
	--unit="hotbox-network-probe-$$" \
	--property=Type=exec \
	--property="RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6" \
	--property=IPAddressDeny=any \
	--property=IPAddressAllow=localhost \
	--property="SystemCallFilter=~connect sendto sendmsg sendmmsg io_uring_setup io_uring_enter io_uring_register" \
	-- "$python" -c '
import errno
import socket

listener = socket.socket()
listener.bind(("127.0.0.1", 0))
probe = socket.socket()
probe.settimeout(2)
raise SystemExit(0 if probe.connect_ex(("1.1.1.1", 443)) == errno.EPERM else 1)
' || {
	echo "run-hotbox-linux: network controls failed their startup probe" >&2
	exit 70
}

exec systemd-run --user --quiet --wait --collect --pty \
	--working-directory="$workspace" \
	--property=Type=exec \
	--property=NoNewPrivileges=yes \
	--property=LimitCORE=0 \
	--property=UMask=0077 \
	--property=PrivateTmp=yes \
	--property=PrivateDevices=yes \
	--property=ProtectSystem=strict \
	--property=ProtectHome=read-only \
	--property=ProtectKernelTunables=yes \
	--property=ProtectKernelModules=yes \
	--property=ProtectControlGroups=yes \
	--property=RestrictSUIDSGID=yes \
	--property=LockPersonality=yes \
	--property=RestrictRealtime=yes \
	--property=RestrictAddressFamilies="AF_UNIX AF_INET AF_INET6" \
	--property=IPAddressDeny=any \
	--property=IPAddressAllow=localhost \
	--property="SystemCallFilter=~connect sendto sendmsg sendmmsg io_uring_setup io_uring_enter io_uring_register" \
	--property="ReadWritePaths=$workspace $vault_dir $XDG_RUNTIME_DIR" \
	--setenv=HTTP_PROXY= \
	--setenv=HTTPS_PROXY= \
	--setenv=ALL_PROXY= \
	--setenv=NO_PROXY= \
	-- "$binary" "$vault"
