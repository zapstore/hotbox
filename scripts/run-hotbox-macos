#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
	echo "usage: $0 /absolute/path/to/hotbox /absolute/path/to/vault /absolute/workspace" >&2
	exit 64
fi
if [ "$(uname -s)" != "Darwin" ]; then
	echo "run-hotbox-macos: macOS is required" >&2
	exit 69
fi
command -v sandbox-exec >/dev/null 2>&1 || {
	echo "run-hotbox-macos: sandbox-exec is unavailable; refusing an unsandboxed fallback" >&2
	exit 69
}
[ -x /usr/bin/python3 ] || {
	echo "run-hotbox-macos: /usr/bin/python3 is required for the fail-closed network probe" >&2
	exit 69
}

binary=$1
vault=$2
workspace=$3
case "$binary:$vault:$workspace" in
	/*:/*:/*) ;;
	*)
		echo "run-hotbox-macos: all paths must be absolute" >&2
		exit 64
		;;
esac
[ -x "$binary" ] || {
	echo "run-hotbox-macos: Hotbox binary is not executable" >&2
	exit 66
}
[ -d "$workspace" ] || {
	echo "run-hotbox-macos: workspace is not a directory" >&2
	exit 66
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
profile=$script_dir/hotbox-macos.sb
[ -r "$profile" ] || {
	echo "run-hotbox-macos: missing Seatbelt profile" >&2
	exit 66
}

/usr/bin/sandbox-exec -f "$profile" /usr/bin/python3 -c '
import errno
import socket

listener = socket.socket()
listener.bind(("127.0.0.1", 0))
listener.listen(1)
client = socket.socket()
client.connect(listener.getsockname())
peer, _ = listener.accept()
client.sendall(b"x")
assert peer.recv(1) == b"x"
external = socket.socket()
external.settimeout(2)
raise SystemExit(0 if external.connect_ex(("1.1.1.1", 443)) == errno.EPERM else 1)
' || {
	echo "run-hotbox-macos: network controls failed their startup probe" >&2
	exit 70
}

ulimit -c 0
cd "$workspace"
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
exec /usr/bin/sandbox-exec -f "$profile" "$binary" "$vault"
